{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/tesserine/groundwork/main/schemas/review-findings.schema.json",
  "title": "Review Findings",
  "description": "Validates the content of a review-findings artifact. Captures review metadata, disposition, and classified observations against a change-proposal version.",
  "type": "object",
  "required": ["work_unit", "against_version", "reviewer", "reviewed_at", "disposition", "findings"],
  "additionalProperties": false,
  "properties": {
    "work_unit": {
      "type": "string",
      "description": "Common envelope - identifies the reviewed proposal's work unit.",
      "pattern": "^[a-z][a-z0-9]*([-.][a-z0-9]+)*$"
    },
    "against_version": {
      "type": "integer",
      "description": "Change-proposal version this review addresses.",
      "minimum": 1
    },
    "reviewer": {
      "type": "string",
      "description": "Reviewer identity.",
      "minLength": 1
    },
    "reviewed_at": {
      "type": "string",
      "description": "Review timestamp.",
      "format": "date-time",
      "minLength": 1
    },
    "disposition": {
      "type": "string",
      "description": "Internal review disposition consumed by land/revise flow.",
      "enum": ["approved", "needs_revision"]
    },
    "findings": {
      "type": "array",
      "description": "Review observations, each classified independently.",
      "items": {
        "$ref": "#/$defs/finding"
      }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "required": ["observation", "classification"],
      "additionalProperties": false,
      "properties": {
        "observation": {
          "type": "string",
          "description": "Review observation.",
          "minLength": 1
        },
        "classification": {
          "type": "string",
          "description": "Whether the observation blocks approval.",
          "enum": ["blocking", "non-blocking"]
        },
        "location": {
          "type": "string",
          "description": "Optional file, schema path, or review-location reference.",
          "minLength": 1
        }
      }
    }
  }
}
