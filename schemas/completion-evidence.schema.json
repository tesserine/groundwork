{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/tesserine/groundwork/main/schemas/completion-evidence.schema.json",
  "title": "Completion Evidence",
  "description": "Validates the content of a completion-evidence artifact. Records performed evidence for every contract criterion in one lens-agnostic result shape.",
  "type": "object",
  "required": ["work_unit", "results", "documentation"],
  "additionalProperties": false,
  "properties": {
    "work_unit": {
      "type": "string",
      "description": "Common envelope - threads to work unit.",
      "pattern": "^[a-z][a-z0-9]*([-.][a-z0-9]+)*$"
    },
    "results": {
      "type": "array",
      "description": "Per-contract-criterion evidence results.",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["criterion_id", "result", "evidence"],
        "additionalProperties": false,
        "properties": {
          "criterion_id": {
            "type": "string",
            "description": "Criterion id from the contract artifact.",
            "pattern": "^[a-z][a-z0-9]*([-.][a-z0-9]+)*$"
          },
          "result": {
            "type": "string",
            "description": "Observed criterion result.",
            "enum": ["pass", "fail"]
          },
          "evidence": {
            "type": "object",
            "description": "Performed evidence: the criterion's stated check performed - a recorded run, a produced artifact, or a recorded finding (attestation), whichever its procedure yields.",
            "required": ["summary"],
            "additionalProperties": false,
            "anyOf": [
              { "required": ["run"] },
              { "required": ["artifact"] },
              { "required": ["attestation"] }
            ],
            "properties": {
              "summary": {
                "type": "string",
                "description": "Concise evidence summary.",
                "minLength": 1
              },
              "run": {
                "type": "object",
                "description": "Executable run evidence.",
                "required": ["command", "result", "output_summary"],
                "additionalProperties": false,
                "properties": {
                  "command": {
                    "type": "string",
                    "minLength": 1
                  },
                  "result": {
                    "type": "string",
                    "enum": ["pass", "fail"]
                  },
                  "output_summary": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "artifact": {
                "type": "object",
                "description": "Artifact evidence produced or inspected by an executable check.",
                "required": ["path", "description"],
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "attestation": {
                "type": "object",
                "description": "Reviewer attestation evidence.",
                "required": ["reviewer", "finding"],
                "additionalProperties": false,
                "properties": {
                  "reviewer": {
                    "type": "string",
                    "minLength": 1
                  },
                  "finding": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "documentation": {
      "type": "object",
      "description": "Documentation impact of the completed change.",
      "required": ["updated", "verified_accurate", "follow_up_work_units"],
      "additionalProperties": false,
      "properties": {
        "updated": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "verified_accurate": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "follow_up_work_units": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
