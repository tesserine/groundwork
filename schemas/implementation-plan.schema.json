{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/tesserine/groundwork/main/schemas/implementation-plan.schema.json",
  "title": "Implementation Plan",
  "description": "Validates the content of an implementation-plan artifact. Bridges the contract to the change with design decisions and criterion-to-step mappings keyed by contract criterion id; each criterion's lens, kind, statement, and check live on the contract artifact.",
  "type": "object",
  "required": ["work_unit", "summary", "design_decisions", "affected_files", "criterion_mapping"],
  "additionalProperties": false,
  "properties": {
    "work_unit": {
      "type": "string",
      "description": "Common envelope — threads to work unit.",
      "pattern": "^[a-z][a-z0-9]*([-.][a-z0-9]+)*$"
    },
    "summary": {
      "type": "string",
      "description": "What the plan accomplishes.",
      "minLength": 1
    },
    "design_decisions": {
      "type": "array",
      "description": "Decisions with rationale.",
      "minItems": 1,
      "items": {
        "type": "object",
        "description": "A design decision with rationale.",
        "required": ["decision", "rationale"],
        "additionalProperties": false,
        "properties": {
          "decision": {
            "type": "string",
            "description": "What was decided.",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "description": "Why — traces to constraints or principles.",
            "minLength": 1
          }
        }
      }
    },
    "affected_files": {
      "type": "array",
      "description": "Files or modules that get changed.",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "criterion_mapping": {
      "type": "array",
      "description": "How contract criteria map to implementation steps — one mapping per contract criterion, keyed by criterion id.",
      "minItems": 1,
      "items": {
        "type": "object",
        "description": "Mapping from a contract criterion to implementation steps.",
        "required": ["criterion_id", "steps"],
        "additionalProperties": false,
        "properties": {
          "criterion_id": {
            "type": "string",
            "description": "Criterion id from the contract artifact.",
            "pattern": "^[a-z][a-z0-9]*([-.][a-z0-9]+)*$"
          },
          "steps": {
            "type": "array",
            "description": "Implementation steps for this criterion.",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
